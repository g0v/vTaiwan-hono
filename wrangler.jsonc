{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vtaiwan-hono",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-17",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "remote": true,
      "binding": "DB",
      "database_name": "vtaiwan-transcriptions",
      "database_id": "af71c224-5fd2-4859-becb-6012ad1fc3b2",
      "migrations_dir": "./migrations",
    },
    {
      "remote": true,
      "binding": "DB_AUTH",
      "database_name": "vtaiwan-auth",
      "database_id": "e26edd14-d163-427d-8630-9304f815e9fa",
      "migrations_dir": "./migrations/auth",
    },
    {
      "remote": true,
      "binding": "DB_CIVIC_TALKS",
      "database_name": "vtaiwan-civic-talks",
      "database_id": "1b5f4077-f5a7-4b0d-9877-952d5726c7b8",
      "migrations_dir": "./migrations/civic-talks",
    },
  ],
  "r2_buckets": [
    {
      "remote": true,
      "binding": "R2",
      "bucket_name": "vtaiwan-meeting-files",
      "preview_bucket_name": "vtaiwan-meeting-files-preview",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "routes": [
    {
      "pattern": "next.vtaiwan.tw",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEETING_ROOM",
        "class_name": "MeetingRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MeetingRoom"],
    },
  ],
}
