# 本機開發設定範本
# 請在專案根目錄執行 `cp .dev.vars.example .dev.vars` 建立設定檔，
# 再將下方的範例值替換成實際憑證。
# 重要提醒：`.dev.vars` 僅供近端開發使用，請勿提交至 Git 版本控制中。

# Mastodon API 存取權杖
MASTODON_TOKEN=YOUR_MASTODON_TOKEN

# Jitsi as a Service（JaaS）設定
JAAS_APP_ID=YOUR_JAAS_APP_ID
JAAS_KEY_ID=YOUR_JAAS_KEY_ID
JAAS_PRIVATE_KEY=YOUR_JAAS_PRIVATE_KEY

# Better Auth 服務網址與簽章密鑰
BETTER_AUTH_URL=YOUR_BETTER_AUTH_URL
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET

# Google OAuth 應用程式憑證
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# GitHub OAuth 應用程式憑證
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET